%% Authentication Testing Flow
%% Source-verified | Social Media App (working UI/admin name: SocialConnect)
flowchart LR
  login["POST /api/users/login/"]
  tokens["access + refresh"]
  protected["Protected request"]
  expired["401 response"]
  refresh["POST token/refresh/"]
  replay["Replay original request"]
  clear["Clear session on failure"]
  blacklist["Blacklist tables"]
  login --> tokens
  tokens -->|"Bearer"| protected
  protected --> expired
  expired -->|"yes"| refresh
  refresh --> replay
  expired -->|"no"| clear
  refresh -->|"rotation"| blacklist
  clear -->|"logout"| blacklist
