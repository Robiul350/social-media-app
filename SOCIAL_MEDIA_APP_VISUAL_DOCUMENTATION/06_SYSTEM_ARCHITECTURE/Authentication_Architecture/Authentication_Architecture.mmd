flowchart LR
  login["Login.jsx"]
  storage["localStorage<br/>• 4 keys"]
  guard["Route guard<br/>• presence only"]
  api["Auth endpoints<br/>• API-010—017"]
  jwt["SimpleJWT<br/>• access + refresh"]
  blacklist["Blacklist tables"]
  refresh["Axios 401 flow<br/>• single-flight"]
