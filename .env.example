DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# For production, set DJANGO_DEBUG=False and provide a private random DJANGO_SECRET_KEY.
# HTTPS security defaults are enabled when DJANGO_DEBUG=False.
# Set DJANGO_USE_HTTPS_PROXY=True only when a trusted proxy sets X-Forwarded-Proto.
# DJANGO_USE_HTTPS_PROXY=False
# Only enable these if every subdomain is HTTPS and HSTS preload is intended:
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True

DB_NAME=social_media_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-database-password
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
